+               av_err2str(rv));
+        sem_destroy(&de->q_sem_out);
+        sem_destroy(&de->q_sem_in);
+        goto fail_close;
+    }
+    de->q_sync_initialized = 1;
+
+    rv = pthread_create(&de->q_thread, NULL, display_thread, s);
